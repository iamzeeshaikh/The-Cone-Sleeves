# SMTP transport for the contact / quote form endpoints.
# Copy to .env and fill in. Never commit .env.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Envelope sender shown on outgoing notifications.
MAIL_FROM=
MAIL_FROM_NAME=

# Comma-separated recipient overrides. Defaults are compiled in from the
# original WordPress form configuration; set these to change them.
FORM_TO_DEFAULT=
FORM_TO_POPUP=
FORM_TO_QUOTE=
