# SMTP transport for the contact / quote form endpoints.
# Copy to .env and fill in. Never commit .env.
#
# Port 465 = implicit TLS, port 587 = STARTTLS; the code picks from the number.
# For Gmail, SMTP_PASS must be a 16-character App Password, not the account
# password (https://myaccount.google.com/apppasswords).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Envelope sender shown on outgoing notifications. May differ from SMTP_USER.
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# Where every form notification is delivered (comma-separated for several).
SMTP_TO=

# Optional per-form overrides; fall back to SMTP_TO when blank.
FORM_TO_DEFAULT=
FORM_TO_POPUP=
FORM_TO_QUOTE=
