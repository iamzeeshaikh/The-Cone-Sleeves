---
/**
 * WhatsApp floating button — replaces the Creame "Join.chat" plugin.
 *
 * The markup is the plugin's own rendered output (its stylesheet targets these
 * exact classes), with two changes: the "Open chat" control is a real link to
 * wa.me instead of something the plugin's JS wired up, and the chatbox starts
 * hidden. Behaviour lives in src/scripts/site.js.
 */
import raw from './_joinchat.html?raw';
import { SITE } from '../data/site';

const waHref = `https://wa.me/${SITE.whatsapp.telephone}?text=${encodeURIComponent(
  SITE.whatsapp.message
)}`;
const html = raw.replace('{{WA_HREF}}', waHref);
---
<Fragment set:html={html} />
