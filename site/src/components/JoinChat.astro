---
// WhatsApp floating button — replaces the Creame "Join.chat" plugin widget.
// Position (bottom-left), colours, badge and bubble copy match the original.
import { SITE } from '../data/site';

const waHref = `https://wa.me/${SITE.whatsapp.telephone}?text=${encodeURIComponent(
  SITE.whatsapp.message
)}`;
---
<div
  class="joinchat joinchat--left joinchat--dark-auto"
  data-telephone={SITE.whatsapp.telephone}
  data-href={waHref}
  aria-hidden="false"
>
  <div class="joinchat__button" role="button" tabindex="0" aria-label="Open Chat">
    <div class="joinchat__button__open"></div>
    <div class="joinchat__button__sendtext">Open chat</div>
    <svg class="joinchat__button__send" viewBox="0 0 400 400" stroke-linecap="round" stroke-width="33">
      <path class="joinchat_svg__plain" d="M168.83 200.504H79.218L33.04 44.284a1 1 0 011.386-1.188l318.313 151.808a6 6 0 010 10.821L34.426 357.533a1 1 0 01-1.386-1.188l29.71-100.502"></path>
      <path class="joinchat_svg__chat" d="M382.083 227.9c-.881 6.75-2.909 13.615-4.75 20.25-9.712 34.98-38.286 62.777-73.833 71.833-6.017 1.533-12.35 2.792-18.583 3.417-6.85.687-13.733.792-20.583.5-5.808-.246-11.583-.912-17.334-1.75-2.4-.35-4.808-.717-7.166-1.25-1.442-.325-3.05-1.15-4.5-1.083-1.575.075-3.4 1.35-4.834 1.958l-9.583 4.084c-6.6 2.816-13.192 5.658-19.792 8.458-1.966.833-4.416 2.35-6.583 2.417-3.933.116-7.35-3.334-6.583-7.334.316-1.658 1.375-3.216 2.083-4.75l4.667-10.083c1.475-3.183 4.408-7.925 4.375-11.417-.033-3.316-4.15-7.05-6.125-9.5-14.334-17.783-22.75-38.766-24.334-61.583-.166-2.4-.25-4.808-.25-7.217 0-3.108.15-6.216.417-9.316 1.7-19.475 8.933-38.359 20.75-53.917 5.017-6.6 10.933-12.617 17.417-17.75 22.941-18.166 53.325-26.407 82.333-22.583 43.108 5.683 79.55 38.808 89.167 81.25 1.166 5.15 1.941 10.375 2.291 15.641.409 6.184.259 12.492-.583 18.634z"></path>
    </svg>
  </div>
  <div class="joinchat__badge">1</div>
  <div class="joinchat__chatbox" role="dialog" aria-modal="true" aria-labelledby="joinchat__label" hidden>
    <div class="joinchat__header">
      <div id="joinchat__label">WhatsApp</div>
      <div class="joinchat__close" role="button" tabindex="0" aria-label="Close"></div>
    </div>
    <div class="joinchat__scroll">
      <div class="joinchat__content">
        <div class="joinchat__chat">
          <div class="joinchat__bubble">{SITE.whatsapp.bubble}</div>
        </div>
        <a class="joinchat__open" href={waHref} target="_blank" rel="noopener noreferrer">
          <div class="joinchat__open__text">Open chat</div>
        </a>
      </div>
    </div>
  </div>
</div>
