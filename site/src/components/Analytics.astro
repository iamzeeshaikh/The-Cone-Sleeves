---
/**
 * Third-party integrations carried over from WordPress, byte-for-byte:
 *   - Google Tag Manager container GTM-K4R5CPR
 * plus the Google tag for GA4 (G-XR2P10889D), which GTM also loads. It is
 * emitted BEFORE the GTM snippet so gtag() owns the instance and the
 * conversion events sent by /ga4-events.js (whatsapp_click, phone_call,
 * email_click, lead_form_submit) reach the property; GTM reuses that instance,
 * so the page still sends exactly one page_view. (Measured on the sister site
 * 2026-09-16: after GTM the events are dropped; send_page_view:false drops the
 * page_view.)
 *
 * GTM was an inline <script> tag in <head> on the live site and is reproduced
 * as-is so the container keeps firing exactly as before. Chat is the
 * LiveChat Desk widget (async external tag, renders in its own shadow root);
 * it replaced Zendesk Chat on 2026-10-21. IDs live in
 * src/data/site.ts; nothing here is a secret.
 */
import { INTEGRATIONS } from '../data/site';
---
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-XR2P10889D"></script>
<script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','G-XR2P10889D');</script>
<script is:inline defer src="/ga4-events.js"></script>

<script is:inline define:vars={{ gtmId: INTEGRATIONS.gtmId }}>
  (function (w, d, s, l, i) {
    w[l] = w[l] || [];
    w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
    var f = d.getElementsByTagName(s)[0],
      j = d.createElement(s),
      dl = l != 'dataLayer' ? '&l=' + l : '';
    j.async = true;
    j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
    f.parentNode.insertBefore(j, f);
  })(window, document, 'script', 'dataLayer', gtmId);
</script>

<script is:inline src="https://livechat-desk-omega.vercel.app/w.js" data-site="theconesleeves-com" async></script>
