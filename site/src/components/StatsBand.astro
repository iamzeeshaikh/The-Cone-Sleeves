---
/**
 * Four operating facts, shown under the hero on every product page. They repeat
 * the figures in data/types.ts FACTS; change them together or the page and the
 * configurator will disagree.
 */
import Icon from './Icon.astro';

const ITEMS = [
  { icon: 'box', figure: '500', label: 'Minimum per design', note: 'Volume pricing from 1,000' },
  { icon: 'clock', figure: '6–7 days', label: 'Standard production', note: 'After you approve the proof' },
  { icon: 'palette', figure: 'Free', label: 'Dieline and proof', note: 'Built around your item' },
  { icon: 'truck', figure: 'Worldwide', label: 'Tracked shipping', note: 'Quoted with the job' },
] as const;
---

<section class="stats">
  <div class="container stats-grid">
    {
      ITEMS.map((s) => (
        <div class="stat">
          <span class="stat-icon">
            <Icon name={s.icon} size={18} />
          </span>
          <div>
            <p class="stat-figure">{s.figure}</p>
            <p class="stat-label">{s.label}</p>
            <p class="stat-note">{s.note}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .stats {
    background: var(--ink-900);
    color: var(--ink-100);
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .stats-grid {
    display: grid;
    gap: var(--sp-5);
    grid-template-columns: repeat(auto-fit, minmax(max(200px, (100% - 3 * var(--sp-5)) / 4), 1fr));
  }

  .stat {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
  }

  .stat-icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.08);
    color: var(--coral-300);
    flex-shrink: 0;
  }

  .stat-figure {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    color: #fff;
    margin: 0;
    line-height: 1.2;
  }

  .stat-label {
    margin: 0.1rem 0 0;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink-200);
  }

  .stat-note {
    margin: 0.15rem 0 0;
    font-size: 0.8rem;
    color: var(--ink-400);
  }
</style>
