---
/**
 * The short quote form used on product pages and in the contact column.
 * Posts to /api/contact/ using the existing Elementor form id so the mail
 * routing, honeypots and thank-you redirect keep working unchanged.
 */
import Icon from './Icon.astro';
import { SITE } from '../data/site';

interface Props {
  /** Prefills the product field and is sent through with the message. */
  product?: string;
  heading?: string;
  intro?: string;
  compact?: boolean;
}

const {
  product = '',
  heading = 'Get a free quote',
  intro = 'Send your size, quantity and artwork. We reply with a written price and a free digital proof.',
  compact = false,
} = Astro.props as Props;
---

<form class="quote-form" method="POST" action="/api/contact/" data-quote-form>
  {/* Field ids match the Elementor form the endpoint already understands. */}
  <input type="hidden" name="form_id" value="2725c75" />
  <input type="hidden" name="source_page" value={Astro.url.pathname} />

  <div>
    <h3 style="margin-bottom:.4rem">{heading}</h3>
    <p class="form-note" style="margin-bottom:1.1rem">{intro}</p>
  </div>

  <div class="quote-grid" data-compact={String(compact)}>
    <div class="field">
      <label for="qf-name">Your name</label>
      <input id="qf-name" name="form_fields[name]" type="text" required autocomplete="name" />
    </div>

    <div class="field">
      <label for="qf-email">Email</label>
      <input id="qf-email" name="form_fields[email]" type="email" required autocomplete="email" />
    </div>

    <div class="field">
      <label for="qf-phone">Phone</label>
      <input
        id="qf-phone"
        name="form_fields[field_dbb1ca6]"
        type="tel"
        autocomplete="tel"
        inputmode="tel"
      />
    </div>

    <div class="field">
      <label for="qf-contact">Preferred contact</label>
      <select id="qf-contact" name="form_fields[field_bbc69d7]">
        <option value="Email">Email</option>
        <option value="Phone">Phone</option>
        <option value="WhatsApp">WhatsApp</option>
      </select>
    </div>
  </div>

  <div class="field" style="margin-top:1rem">
    <label for="qf-message">What do you need?</label>
    <textarea
      id="qf-message"
      name="form_fields[message]"
      required
      placeholder={
        product
          ? `${product} — cone or item size, quantity, and any artwork notes.`
          : 'Product, size, quantity and any artwork notes.'
      }>{product ? `Product: ${product}\n` : ''}</textarea>
  </div>

  {/* Honeypot: named the way the endpoint expects, hidden from people. */}
  <div class="hp-field" aria-hidden="true">
    <label for="qf-hp">Leave this empty</label>
    <input id="qf-hp" name="form_fields[field_179dce0]" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <p class="form-msg error" data-form-error hidden></p>

  <button class="btn btn-primary btn-block btn-lg" type="submit" style="margin-top:1.1rem">
    <span data-submit-label>Send my request</span>
    <Icon name="arrow" size={17} />
  </button>

  <p class="form-note" style="margin-top:.85rem;text-align:center">
    {SITE.replyPromise}. No obligation, no spam.
  </p>
</form>

<style>
  .quote-form {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--sp-6);
    box-shadow: var(--shadow);
  }

  .quote-grid {
    display: grid;
    gap: var(--sp-4);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .quote-grid[data-compact='true'] {
    grid-template-columns: minmax(0, 1fr);
  }

  @media (max-width: 560px) {
    .quote-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .quote-form {
      padding: var(--sp-5);
    }
  }
</style>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-quote-form]')) {
    const err = form.querySelector<HTMLElement>('[data-form-error]')!;
    const label = form.querySelector<HTMLElement>('[data-submit-label]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const original = label.textContent;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      err.hidden = true;
      button.disabled = true;
      label.textContent = 'Sending…';

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) throw new Error(data.error || 'We could not send that. Please try again.');
        window.location.assign(data.redirect || '/thank-you/');
      } catch (e) {
        err.textContent = e instanceof Error ? e.message : 'Something went wrong. Please try again.';
        err.hidden = false;
        button.disabled = false;
        label.textContent = original;
      }
    });
  }
</script>
