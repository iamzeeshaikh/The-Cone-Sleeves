---
import Layout from '../layouts/Layout.astro';
import seoData from '../data/seo.json';
import content from '../content/get-a-free-quote.html?raw';
import '../styles/pages/get-a-free-quote.css';
import '../styles/gravityforms.css';
const seo = seoData["/get-a-free-quote/"];
const bodyClass = "wp-singular page-template page-template-elementor_header_footer page page-id-3277 wp-custom-logo wp-embed-responsive wp-theme-rishi theme-rishi box-layout rightsidebar elementor-default elementor-template-full-width elementor-kit-3067";
const bodyAttrs = {"data-link": "type-2", "data-forms": "classic", "data-prefix": "single_page", "data-header": "type-1", "data-footer": "type-1"};
---
<Layout seo={seo} bodyClass={bodyClass} bodyAttrs={bodyAttrs} stem="get-a-free-quote" hasPopup={false}>
  <Fragment set:html={content} />
</Layout>
