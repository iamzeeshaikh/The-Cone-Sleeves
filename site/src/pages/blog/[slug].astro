---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Picture from '../../components/Picture.astro';
import { POSTS } from '../../data/posts';
import { SITE } from '../../data/site';
import { abs, ORG_ID } from '../../lib/seo';
import Configurator from '../../components/Configurator.astro';

export function getStaticPaths() {
  return POSTS.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: (typeof POSTS)[number] };
const path = `/blog/${post.slug}/`;

const others = POSTS.filter((p) => p.slug !== post.slug).slice(0, 3);

const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const schema = [
  {
    '@type': 'BlogPosting',
    '@id': `${abs(path)}#article`,
    headline: post.title,
    description: post.description,
    image: abs(post.image),
    datePublished: post.published,
    dateModified: post.updated ?? post.published,
    author: { '@id': ORG_ID },
    publisher: { '@id': ORG_ID },
    mainEntityOfPage: abs(path),
    inLanguage: 'en-US',
    wordCount: post.body.replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length,
    timeRequired: `PT${post.readingMinutes}M`,
  },
];
---

<Base
  title={post.title.length > 52 ? post.title : `${post.title} | ${SITE.name}`}
  description={post.description}
  path={path}
  image={post.image}
  imageAlt={post.imageAlt}
  ogType="article"
  crumbs={[{ name: 'Blog', path: '/blog/' }, { name: post.title, path }]}
  schema={schema}
>
  <article>
    <header class="post-head">
      <div class="container-narrow">
        <ol class="crumbs">
          <li><a href="/">Home</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li aria-current="page">{post.title}</li>
        </ol>
        <h1>{post.title}</h1>
        <p class="post-lead">{post.description}</p>
        <p class="post-meta">
          <time datetime={post.published}>{fmt(post.published)}</time>
          <span aria-hidden="true">·</span>
          <span>{post.readingMinutes} min read</span>
        </p>
      </div>
    </header>

    <figure class="post-hero container">
      <Picture src={post.image} alt={post.imageAlt} width={1200} height={675} sizes="(max-width: 980px) 100vw, 940px" loading="eager" fetchpriority="high" />
    </figure>

    <div class="container-narrow prose post-body">
      <Fragment set:html={post.body} />
    </div>

    <div class="container-narrow">
      <div class="post-cta">
        <div>
          <h2 style="font-size:var(--step-2);margin-bottom:.5rem">Ready to price your sleeves?</h2>
          <p style="color:var(--ink-600);margin:0">
            Send your size and quantity. The dieline and the digital proof are free either way.
          </p>
        </div>
        <a class="btn btn-primary btn-lg" href="/get-a-free-quote/">
          Get a Free Quote<Icon name="arrow" size={17} />
        </a>
      </div>
    </div>
  </article>

  <section class="section bg-alt">
    <div class="container">
      <h2 style="margin-bottom:var(--sp-6)">More guides</h2>
      <div class="grid grid-3">
        {
          others.map((p) => (
            <a class="card card-link" href={`/blog/${p.slug}/`}>
              <div class="card-media">
                <Picture src={p.image} alt={p.imageAlt} width={768} height={576} sizes="(max-width: 700px) 100vw, 380px" />
              </div>
              <div class="card-body">
                <h3 class="card-title" style="font-size:var(--step-1)">{p.title}</h3>
                <p class="card-text">{p.description}</p>
                <span class="card-cta">
                  Read guide <Icon name="arrow" size={15} />
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <Configurator
    heading="Put this into a quote"
    intro="If the guide has settled what you need, the five steps below turn it into a specification we can price."
  />
</Base>

<style>
  .post-head {
    background: linear-gradient(180deg, var(--paper-blush), var(--paper));
    padding-block: clamp(2rem, 1rem + 4vw, 3.5rem) var(--sp-6);
  }

  .post-head h1 {
    font-size: var(--step-4);
    max-width: 22ch;
  }

  .post-lead {
    font-size: var(--step-1);
    color: var(--ink-600);
    max-width: 60ch;
  }

  .post-meta {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    font-size: 0.87rem;
    color: var(--text-muted);
    margin: 0;
  }

  .post-hero {
    margin: 0 auto var(--sp-7);
    max-width: min(100% - 2.5rem, 940px);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
    background: var(--paper-cream);
  }

  .post-hero img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .post-body {
    padding-bottom: var(--sp-7);
  }

  .post-body :global(h2) {
    font-size: var(--step-2);
  }

  .post-body :global(h3) {
    font-size: var(--step-1);
  }

  .post-body :global(p),
  .post-body :global(li) {
    color: var(--ink-600);
  }

  .post-body :global(blockquote) {
    margin: var(--sp-6) 0;
    padding: var(--sp-4) var(--sp-5);
    border-left: 4px solid var(--coral-400);
    background: var(--paper-warm);
    border-radius: 0 var(--radius) var(--radius) 0;
    font-size: var(--step-1);
  }

  .post-body :global(table) {
    margin: var(--sp-5) 0;
    font-size: 0.95rem;
  }

  .post-body :global(th),
  .post-body :global(td) {
    border: 1px solid var(--line);
    padding: 0.7rem 1rem;
    text-align: left;
  }

  .post-body :global(th) {
    background: var(--paper-warm);
  }

  .post-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-5);
    flex-wrap: wrap;
    padding: var(--sp-6);
    background: var(--paper-blush);
    border: 1px solid var(--coral-100);
    border-radius: var(--radius-lg);
    margin-bottom: var(--sp-8);
  }
</style>
