---
/**
 * About page.
 *
 * The WordPress original claimed a "state-of-the-art facility", "the latest
 * technology and machinery" and "rigorous quality control measures" — none of
 * which anyone here can substantiate, and all of which read as filler. It is
 * rewritten around what is verifiable: what we print, how ordering works and
 * what we will and will not promise.
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Picture from '../components/Picture.astro';
import Gallery from '../components/Gallery.astro';
import StatsBand from '../components/StatsBand.astro';
import Configurator from '../components/Configurator.astro';
import { SITE } from '../data/site';
import { ALL_PRODUCTS } from '../data/products';
import { abs } from '../lib/seo';

/** A cross-section of the range, used by the gallery below the copy. */
const work = [
  { src: '/media/lib/custom-cardboard-cone-sleeves/custom-cardboard-cone-sleeves-detail-6.jpg', alt: 'A spread of cone sleeves showing eight different printed designs' },
  { src: '/media/lib/custom-printed-coffee-sleeves/custom-printed-coffee-sleeves-detail-5.jpg', alt: 'Two cups wearing kraft sleeves printed with a moka pot illustration' },
  { src: '/media/lib/custom-combo-meal-trays/combo-meal-trays.jpg', alt: 'Orange catering tray holding a platter of wraps and dips' },
  { src: '/media/lib/custom-crepe-sleeves/crepe-sleeves-packaging.jpg', alt: 'Gold crepe sleeve with a black circular logo held in one hand' },
  { src: '/media/lib/custom-hot-dog-trays/custom-hot-dog-trays.jpg', alt: 'Three kraft hot dog trays loaded and lined up on a counter' },
  { src: '/media/lib/custom-popcorn-sleeves/custom-popcorn-sleeves.jpg', alt: 'Two printed popcorn tubs filled with caramel corn' },
  { src: '/media/lib/ice-cream-cone-holder/ice-cream-cone-paper-holder.jpg', alt: 'Branded kraft cone caddy holding filled paper cones' },
  { src: '/media/lib/custom-pizza-slice-sleeves/custom-pizza-slice-sleeves.jpg', alt: 'White and red wedge-shaped pizza slice holder' },
];

const schema = [
  {
    '@type': 'AboutPage',
    '@id': `${SITE.origin}/about/#webpage`,
    url: `${SITE.origin}/about/`,
    name: 'About The Cone Sleeves',
    isPartOf: { '@id': `${SITE.origin}/#website` },
    about: { '@id': `${SITE.origin}/#organization` },
    primaryImageOfPage: abs('/media/lib/custom-waffle-cone-sleeves/custom-waffle-cone-sleeves.jpg'),
  },
];
---

<Base
  title="About The Cone Sleeves | Custom Sleeve & Tray Printing"
  description="Who we are, what we print and how ordering works. Custom cone sleeves, food sleeves and trays from 500 pieces, with free design support and digital proofs."
  path="/about/"
  image="/media/lib/custom-waffle-cone-sleeves/custom-waffle-cone-sleeves.jpg"
  imageAlt="White waffle cone sleeve printed with a navy polka dot pattern"
  crumbs={[{ name: 'About', path: '/about/' }]}
  schema={schema}
>
  <section class="about-hero">
    <div class="container about-grid">
      <div>
        <p class="eyebrow eyebrow-line">About us</p>
        <h1>We print the paper that carries your brand out the door</h1>
        <p class="about-lead">
          The Cone Sleeves is a custom print shop for food service packaging. We make the printed
          sleeves, wraps and trays that go around what your customers eat with their hands — cones,
          burgers, sandwiches, hot dogs, donuts and cups — and we print them to your artwork, in
          your sizes, from {ALL_PRODUCTS.length} formats.
        </p>
      </div>
      <div class="about-media">
        <Picture
          src="/media/lib/custom-waffle-cone-sleeves/custom-waffle-cone-sleeves.jpg"
          alt="White waffle cone sleeve printed with a navy polka dot pattern"
          width={1024}
          height={1024}
          sizes="(max-width: 900px) 100vw, 460px"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <StatsBand />

  <section class="section">
    <div class="container-narrow prose">
      <h2>What we actually do</h2>
      <p>
        Most packaging suppliers sell from a catalogue of stock sizes and hope one of them fits.
        We work the other way round: you tell us the cone, cup or burger you serve, we build the
        cutting template around it, and the sleeve fits because it was measured to fit. That is the
        whole business, and it is why we ask for a sample or a photo with a ruler before quoting.
      </p>
      <p>
        Everything is made to order. There is no warehouse of pre-printed stock, which means the
        minimum is genuinely low — 500 pieces per design — and a small shop can test a design
        without buying a pallet of it. Our guide on
        <a href="/blog/bulk-ordering-lead-times-and-moqs/">bulk ordering, lead times and minimums</a>
        explains how run size affects what you pay.
      </p>

      <h2>What ordering with us looks like</h2>
      <p>
        You send the details, we send a written quote and a free dieline. Once the artwork is
        settled you get a digital proof: the flat cutting layout plus a mock-up showing the design
        on the product. Nothing goes to press until you approve that proof in writing. Production
        then takes six to seven business days, or three to four on a rush.
      </p>
      <p>
        Design help is included. If you have a print-ready PDF we will check the bleed, safe
        margins and color build. If all you have is a logo and an idea, our team lays the sleeve
        out for you at no cost — there is no design fee and no artwork charge on any order.
      </p>

      <h2>What we will not tell you</h2>
      <p>
        We do not quote a delivery date we cannot hold, and we do not claim certifications we do
        not have. If a finish will not survive what you are serving, or if a board is wrong for a
        greasy item, we will say so before you order rather than after. That is easier for
        everyone than a reprint.
      </p>
      <p>
        We also will not push you to the most expensive option. Uncoated kraft is often the right
        answer for a shop that leads on sustainability, and it costs less than a laminated sleeve.
        The comparison in
        <a href="/blog/cone-sleeve-materials-explained/">our guide to sleeve materials</a>
        lays out where each board makes sense.
      </p>
    </div>
  </section>

  <section class="section bg-cream">
    <div class="container">
      <div class="grid grid-3">
        {
          [
            {
              icon: 'ruler',
              t: 'Cut to your item',
              d: 'Every dieline is built around the cone, cup or burger you actually serve, not a nearest-fit stock size.',
            },
            {
              icon: 'palette',
              t: 'Design included',
              d: 'Artwork checks, layout and the dieline cost nothing, whether you send a print-ready file or a logo.',
            },
            {
              icon: 'file',
              t: 'Proof before press',
              d: 'A flat proof and a product mock-up land in your inbox. Nothing prints until you approve them.',
            },
            {
              icon: 'box',
              t: 'From 500 pieces',
              d: 'Low enough to test a design or run one seasonal flavor, with volume pricing from 1,000.',
            },
            {
              icon: 'leaf',
              t: 'Recyclable options',
              d: 'Kraft, recycled and uncoated white board all go in the paper stream where local rules require it.',
            },
            {
              icon: 'truck',
              t: 'Shipped tracked',
              d: 'Flat-packed, boxed by the hundred and shipped worldwide with tracking on every order.',
            },
          ].map((c) => (
            <div class="tile">
              <span class="tile-icon">
                <Icon name={c.icon as any} size={20} />
              </span>
              <h3>{c.t}</h3>
              <p>{c.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Gallery
    images={work}
    eyebrow="Recent work"
    heading="Some of what has come off the presses"
    intro="Every one of these started as a customer's artwork and a measurement of the item it had to fit."
  />

  <Configurator
    eyebrow="Packaging designer"
    heading="Design your own packaging"
    intro="If you would rather build the specification than write an email, this asks the same questions we would."
  />

  <section class="section">
    <div class="container-narrow center">
      <h2>Talk to us about your packaging</h2>
      <p style="color:var(--text-muted);max-width:52ch;margin-inline:auto">
        Tell us what you serve and how many you need. If we are not the right printer for it, we
        will tell you that too.
      </p>
      <div style="display:flex;gap:.75rem;justify-content:center;flex-wrap:wrap;margin-top:1.5rem">
        <a class="btn btn-primary btn-lg" href="/get-a-free-quote/">
          Get a Free Quote<Icon name="arrow" size={17} />
        </a>
        <a class="btn btn-ghost btn-lg" href={`tel:${SITE.phone}`}>
          <Icon name="phone" size={16} />{SITE.phone}
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .about-hero {
    background: linear-gradient(180deg, var(--paper-blush) 0%, var(--paper) 100%);
    padding-block: clamp(2.5rem, 1rem + 5vw, 4.5rem);
  }
  .about-grid {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: center;
  }
  .about-lead {
    font-size: var(--step-1);
    color: var(--ink-600);
    max-width: 52ch;
  }
  .about-media {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }
  .about-media img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }
  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
