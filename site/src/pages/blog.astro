---
// Hand-maintained: /blog/ was an empty "Nothing Found" archive on WordPress.
// tools/extract.py leaves this file alone (see HAND_WRITTEN).
import Layout from '../layouts/Layout.astro';
import seoData from '../data/seo.json';
import { postByDate } from '../data/posts';
import { SITE } from '../data/site';
import '../styles/pages/blog.css';
import '../styles/blog.css';

const posts = postByDate();
const seo = {
  ...seoData['/blog/'],
  title: 'Blog | Cone Sleeve Guides & Packaging Advice | The Cone Sleeves',
  description:
    'Practical guides on cone sleeve sizing, materials, printing and bulk ordering, written for ice cream shops, cafés and food vendors.',
  robots: 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
  og: {
    ...seoData['/blog/'].og,
    title: 'Blog',
    description:
      'Practical guides on cone sleeve sizing, materials, printing and bulk ordering.',
  },
  schema: [
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'The Cone Sleeves Blog',
      url: `${SITE.origin}/blog/`,
      description:
        'Practical guides on cone sleeve sizing, materials, printing and bulk ordering.',
      hasPart: posts.map((p) => ({
        '@type': 'BlogPosting',
        headline: p.title,
        url: `${SITE.origin}/blog/${p.slug}/`,
        datePublished: p.published,
      })),
    },
  ],
};

const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout seo={seo} bodyClass="blog wp-custom-logo wp-embed-responsive wp-theme-rishi theme-rishi hfeed default-layout blog-classic" bodyAttrs={{ 'data-link': 'type-2', 'data-forms': 'classic', 'data-prefix': 'blog', 'data-header': 'type-1', 'data-footer': 'type-1' }} stem="blog" hasPopup={false}>
  <div class="site-content reveal_none_desktop reveal_none_tablet reveal_none_mobile">
    <div class="rishi-container">
      <div class="main-content-wrapper clear">
        <main class="site-main">
          <header class="tcs-archive-head">
            <h1>Cone Sleeve Guides</h1>
            <p>
              Practical advice on sizing, materials, printing and bulk ordering — written for the
              people actually serving cones, wraps and coffee behind a counter.
            </p>
          </header>

          <div class="tcs-post-list">
            {posts.map((post) => (
              <article class="tcs-card">
                <a class="tcs-card__media" href={`/blog/${post.slug}/`} aria-hidden="true" tabindex="-1">
                  <img src={post.image} alt="" width="600" height="400" loading="lazy" decoding="async" />
                </a>
                <div class="tcs-card__body">
                  <div class="tcs-card__meta">
                    <time datetime={post.published}>{fmt(post.published)}</time>
                    <span> · {post.readingMinutes} min read</span>
                  </div>
                  <h2><a href={`/blog/${post.slug}/`}>{post.title}</a></h2>
                  <p>{post.description}</p>
                  <a class="tcs-readmore" href={`/blog/${post.slug}/`}>Read more →</a>
                </div>
              </article>
            ))}
          </div>
        </main>
      </div>
    </div>
  </div>
</Layout>
