---
import ExtraFaqs from '../components/ExtraFaqs.astro';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Picture from '../components/Picture.astro';
import { POSTS } from '../data/posts';
import { SITE } from '../data/site';
import { abs } from '../lib/seo';
import Configurator from '../components/Configurator.astro';

const posts = [...POSTS].sort(
  (a, b) => new Date(b.published).getTime() - new Date(a.published).getTime()
);
const [lead, ...rest] = posts;

const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${SITE.origin}/blog/#webpage`,
    url: `${SITE.origin}/blog/`,
    name: 'Cone Sleeve Guides & Packaging Advice',
    isPartOf: { '@id': `${SITE.origin}/#website` },
  },
  {
    '@type': 'ItemList',
    itemListElement: posts.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: abs(`/blog/${p.slug}/`),
      name: p.title,
    })),
  },
];
---

<Base
  title="Blog | Cone Sleeve Guides & Packaging Advice"
  description="Practical guides to buying custom cone sleeves and food packaging: sizing, board choice, artwork setup, minimums and lead times, and whether branding pays."
  path="/blog/"
  crumbs={[{ name: 'Blog', path: '/blog/' }]}
  schema={schema}
>
  <section class="section-tight" style="background:linear-gradient(180deg,var(--paper-blush),var(--paper))">
    <div class="container">
      <p class="eyebrow eyebrow-line">Guides</p>
      <h1 style="max-width:20ch">Practical advice before you order</h1>
      <p style="font-size:var(--step-1);color:var(--ink-600);max-width:56ch">
        Short, specific guides on sizing, board, artwork and run sizes. Written for shop owners
        buying printed packaging, not for search engines.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {
        lead && (
          <a class="blog-lead" href={`/blog/${lead.slug}/`}>
            <div class="blog-lead-media">
              <Picture src={lead.image} alt={lead.imageAlt} width={1024} height={640} sizes="(max-width: 860px) 100vw, 600px" loading="eager" fetchpriority="high" />
            </div>
            <div class="blog-lead-body">
              <span class="pill">Latest guide</span>
              <h2>{lead.title}</h2>
              <p>{lead.description}</p>
              <p class="blog-meta">
                {fmt(lead.published)} · {lead.readingMinutes} min read
              </p>
              <span class="card-cta">
                Read the guide <Icon name="arrow" size={15} />
              </span>
            </div>
          </a>
        )
      }

      <div class="grid grid-3" style="margin-top:var(--sp-7)">
        {
          rest.map((post) => (
            <a class="card card-link" href={`/blog/${post.slug}/`}>
              <div class="card-media">
                <Picture src={post.image} alt={post.imageAlt} width={768} height={576} sizes="(max-width: 700px) 100vw, 380px" />
              </div>
              <div class="card-body">
                <h3 class="card-title" style="font-size:var(--step-1)">{post.title}</h3>
                <p class="card-text">{post.description}</p>
                <p class="blog-meta" style="margin:0">
                  {fmt(post.published)} · {post.readingMinutes} min read
                </p>
                <span class="card-cta">
                  Read guide <Icon name="arrow" size={15} />
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <Configurator
    eyebrow="Packaging designer"
    heading="Design your packaging"
    intro="Answer what you know about the job and we come back with a written price and a free dieline."
  />
  <ExtraFaqs />
</Base>

<style>
  .blog-lead {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .blog-lead:hover {
    box-shadow: var(--shadow);
    border-color: var(--coral-200);
    color: inherit;
  }

  .blog-lead-media {
    background: var(--paper-cream);
    align-self: stretch;
  }

  .blog-lead-media img {
    width: 100%;
    height: 100%;
    min-height: 260px;
    object-fit: cover;
  }

  .blog-lead-body {
    padding: clamp(1.5rem, 3vw, 2.5rem) clamp(1.5rem, 3vw, 2.5rem) clamp(1.5rem, 3vw, 2.5rem) 0;
  }

  .blog-lead-body h2 {
    font-size: var(--step-3);
    margin: var(--sp-3) 0 var(--sp-3);
  }

  .blog-lead-body p {
    color: var(--text-muted);
  }

  .blog-meta {
    font-size: 0.83rem;
    color: var(--text-muted);
  }

  @media (max-width: 860px) {
    .blog-lead {
      grid-template-columns: minmax(0, 1fr);
    }
    .blog-lead-body {
      padding: 0 var(--sp-5) var(--sp-5);
    }
  }
</style>
