---
import Layout from '../layouts/Layout.astro';
import seoData from '../data/seo.json';
import content from '../content/privacy-policy.html?raw';
import '../styles/pages/privacy-policy.css';
const seo = seoData["/privacy-policy/"];
const bodyClass = "privacy-policy wp-singular page-template-default page page-id-3 wp-custom-logo wp-embed-responsive wp-theme-rishi theme-rishi box-layout rightsidebar elementor-default elementor-kit-3067";
const bodyAttrs = {"data-link": "type-2", "data-forms": "classic", "data-prefix": "single_page", "data-header": "type-1", "data-footer": "type-1"};
---
<Layout seo={seo} bodyClass={bodyClass} bodyAttrs={bodyAttrs} stem="privacy-policy" hasPopup={false}>
  <Fragment set:html={content} />
</Layout>
