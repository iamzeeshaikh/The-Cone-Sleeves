---
/**
 * Search results. A static build cannot query a database, so `/?s=<query>` is
 * redirected here (see vercel.json) and matched client-side against an index
 * built at compile time from the product and post data.
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { ALL_PRODUCTS } from '../data/products';
import { productBySlug } from '../data/nav';
import { POSTS } from '../data/posts';
import { stripTags } from '../lib/seo';

const index = [
  ...ALL_PRODUCTS.map((p) => {
    const nav = productBySlug(p.slug)!;
    return {
      title: nav.label,
      path: nav.path,
      kind: 'Product',
      text: p.quickAnswer,
      terms: [p.name, ...p.keywords, ...p.useCases].join(' ').toLowerCase(),
    };
  }),
  ...POSTS.map((p) => ({
    title: p.title,
    path: `/blog/${p.slug}/`,
    kind: 'Guide',
    text: p.description,
    terms: `${p.title} ${p.description} ${stripTags(p.body).slice(0, 600)}`.toLowerCase(),
  })),
  { title: 'Get a Free Quote', path: '/get-a-free-quote/', kind: 'Page', text: 'Request a written price for custom printed packaging.', terms: 'quote price cost estimate order' },
  { title: 'Contact', path: '/contact/', kind: 'Page', text: 'Call, email or message the team that prints the job.', terms: 'contact phone email address whatsapp support' },
  { title: 'About', path: '/about/', kind: 'Page', text: 'Who we are and how ordering works.', terms: 'about company who we are story' },
];
---

<Base
  title="Search | The Cone Sleeves"
  description="Search custom cone sleeves, food sleeves, trays and buying guides on The Cone Sleeves."
  path="/search/"
  noindex={true}
  hideCta={true}
>
  <section class="section">
    <div class="container-narrow">
      <p class="eyebrow eyebrow-line">Search</p>
      <h1 id="search-heading">Search results</h1>

      <form class="search-form" role="search" data-search-form>
        <label class="visually-hidden" for="s">Search this site</label>
        <input id="s" name="s" type="search" placeholder="Try “waffle cone” or “lead time”" autocomplete="off" />
        <button class="btn btn-primary" type="submit"><Icon name="search" size={16} />Search</button>
      </form>

      <p class="form-note" data-search-count></p>
      <div class="search-results" data-search-results></div>
    </div>
  </section>
</Base>

<script is:inline define:vars={{ index }}>
  window.__TCS_INDEX = index;
</script>

<script>
  const form = document.querySelector('[data-search-form]');
  const input = document.getElementById('s');
  const list = document.querySelector('[data-search-results]');
  const count = document.querySelector('[data-search-count]');
  const heading = document.getElementById('search-heading');
  const index = window.__TCS_INDEX || [];

  function render(query) {
    const q = query.trim().toLowerCase();
    if (!list || !count) return;
    if (!q) {
      count.textContent = 'Type a word to search products and guides.';
      list.innerHTML = '';
      return;
    }
    const words = q.split(/\s+/).filter(Boolean);
    const hits = index
      .map((item) => {
        const hay = (item.title + ' ' + item.text + ' ' + item.terms).toLowerCase();
        let score = 0;
        for (const w of words) {
          if (item.title.toLowerCase().includes(w)) score += 5;
          if (hay.includes(w)) score += 1;
        }
        return { item, score };
      })
      .filter((r) => r.score > 0)
      .sort((a, b) => b.score - a.score);

    if (heading) heading.textContent = `Search results for “${query.trim()}”`;
    count.textContent = hits.length
      ? `${hits.length} result${hits.length === 1 ? '' : 's'}`
      : 'No matches. Try a broader word, or ask us directly on the contact page.';

    list.innerHTML = hits
      .map(
        ({ item }) =>
          `<a class="search-hit" href="${item.path}"><span class="pill">${item.kind}</span><h2>${item.title}</h2><p>${item.text}</p></a>`
      )
      .join('');
  }

  const initial = new URLSearchParams(location.search).get('s') || '';
  if (input) input.value = initial;
  render(initial);

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const value = input?.value || '';
    history.replaceState(null, '', `/search/?s=${encodeURIComponent(value)}`);
    render(value);
  });
  input?.addEventListener('input', () => render(input.value));
</script>

<style>
  .search-form {
    display: flex;
    gap: 0.6rem;
    margin: var(--sp-5) 0 var(--sp-4);
    flex-wrap: wrap;
  }
  .search-form input {
    flex: 1 1 240px;
    padding: 0.85rem 1.1rem;
    border: 1.5px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--surface);
  }
  .search-form input:focus {
    border-color: var(--coral-400);
    outline: none;
    box-shadow: 0 0 0 3px var(--coral-50);
  }
  .search-results {
    display: grid;
    gap: var(--sp-4);
    margin-top: var(--sp-5);
  }
  .search-results :global(.search-hit) {
    display: block;
    padding: var(--sp-5);
    background: var(--surface);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
    text-decoration: none;
    color: inherit;
  }
  .search-results :global(.search-hit:hover) {
    border-color: var(--coral-300);
  }
  .search-results :global(.search-hit h2) {
    font-size: var(--step-1);
    margin: 0.55rem 0 0.3rem;
  }
  .search-results :global(.search-hit p) {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.94rem;
  }
</style>
